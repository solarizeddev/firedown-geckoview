# Firedown GeckoView build configuration. Edit to taste, then run ./build.sh.
#
# Everything here is sourced by the scripts/ steps. Keep it shell-safe (no spaces
# around '=').

# --- Version -------------------------------------------------------------------
# Which Firefox/GeckoView to build. The MAJOR must line up with the GeckoView API
# Firedown calls, i.e. keep it in step with firedown app/build.gradle's
# geckoviewVersion major (151 at time of writing).
FIREFOX_VERSION="151.0"
# Release tag used by the git/hg source methods (vanilla Mozilla tag naming).
FIREFOX_TAG="FIREFOX_151_0_RELEASE"

# --- GeckoView artifact version pinning ----------------------------------------
# The published GeckoView Maven coordinate is <milestone>.<buildid>, e.g.
#   151.0.20260601110758
# The milestone (151.0) comes from the source tree; the buildid is normally the
# wall-clock time of the build, which makes the version non-reproducible and
# unpredictable. Pin the buildid here so every ABI + the fat-AAR publish under
# ONE fixed coordinate that the app's app/build.gradle `geckoviewVersion` can
# reference. 04-build.sh exports this as MOZ_BUILD_DATE for all mach builds.
#
# NOTE: pinning only fixes the version *label* — the engine code is still the
# FIREFOX_TAG source above (151.0 release). Bumping just the buildid does NOT
# pull newer Gecko code; bump FIREFOX_VERSION/FIREFOX_TAG for that.
# Format: YYYYMMDDHHMMSS (14 digits). Leave empty to use the build's wall clock.
GECKOVIEW_BUILD_DATE="20260601110758"
# Full coordinate the above produces (milestone.buildid); used by 05-sync as the
# expected version to wire into the app.
GECKOVIEW_VERSION="${FIREFOX_VERSION}.${GECKOVIEW_BUILD_DATE}"

# --- Source acquisition --------------------------------------------------------
# git     : shallow clone of the official mozilla-firefox git repo at FIREFOX_TAG
#           (default — the best-supported path for `mach bootstrap` on Android).
# tarball : firefox-<ver>.source.tar.xz from archive.mozilla.org (smallest DL,
#           no VCS history; bootstrap still works for the Android toolchain).
# hg      : Mercurial mozilla-unified (classic ./mach workflow, largest).
SOURCE_METHOD="git"

# Where the checked-out source tree lives. Kept OUT of this git repo (.gitignore)
# — it is tens of GB. Override by exporting GECKO_SRC before running.
GECKO_SRC="${GECKO_SRC:-$PWD/gecko}"

# --- Build targets -------------------------------------------------------------
# Android ABIs to build, space-separated Rust target triples. We ship two:
#   aarch64-linux-android  -> arm64-v8a (phones/tablets)
#   x86_64-linux-android   -> x86_64    (emulators / Chromebooks)
# Each is built into its own objdir, then 04-build.sh fat-AARs them into one
# multi-ABI artifact published to mavenLocal. Other valid triples:
#   arm-linux-androideabi  -> armeabi-v7a
#   i686-linux-android     -> x86
ANDROID_TARGETS="aarch64-linux-android x86_64-linux-android"

# --- App integration -----------------------------------------------------------
# Path to your local firedown app checkout, used by 05-sync-to-app.sh to print
# (and optionally apply) the build.gradle wiring. Override via env if elsewhere.
FIREDOWN_APP="${FIREDOWN_APP:-$HOME/firedown}"
