# Firedown GeckoView build configuration. Edit to taste, then run ./build.sh.
#
# Everything here is sourced by the scripts/ steps. Keep it shell-safe (no spaces
# around '=').

# --- Version -------------------------------------------------------------------
# Which Firefox/GeckoView to build. The MAJOR must line up with the GeckoView API
# Firedown calls, i.e. keep it in step with firedown app/build.gradle's
# geckoviewVersion major (151 at time of writing).
FIREFOX_VERSION="153.0"
# Release tag used by the git/hg source methods (vanilla Mozilla tag naming).
FIREFOX_TAG="FIREFOX_153_0_RELEASE"

# --- GeckoView artifact version pinning ----------------------------------------
# The published GeckoView Maven coordinate is <milestone>.<buildid>, e.g.
#   151.0.20260601110758
# The milestone (151.0) comes from the source tree; the buildid is normally the
# wall-clock time of the build, which makes the version non-reproducible and
# unpredictable. Pin the buildid here so every ABI + the fat-AAR publish under
# ONE fixed coordinate that the app's app/build.gradle `geckoviewVersion` can
# reference. 04-build.sh exports this as MOZ_BUILD_DATE for all mach builds.
#
# NOTE: pinning only fixes the version *label* — the engine code is still the
# FIREFOX_TAG source above (151.0 release). Bumping just the buildid does NOT
# pull newer Gecko code; bump FIREFOX_VERSION/FIREFOX_TAG for that.
# Format: YYYYMMDDHHMMSS (14 digits). Leave empty to use the build's wall clock.
GECKOVIEW_BUILD_DATE="20260803132010"
# Full coordinate the above produces (milestone.buildid); used by 05-sync as the
# expected version to wire into the app.
GECKOVIEW_VERSION="${FIREFOX_VERSION}.${GECKOVIEW_BUILD_DATE}"

# --- Source acquisition --------------------------------------------------------
# git     : shallow clone of the official mozilla-firefox git repo at FIREFOX_TAG
#           (default — the best-supported path for `mach bootstrap` on Android).
# tarball : firefox-<ver>.source.tar.xz from archive.mozilla.org (smallest DL,
#           no VCS history; bootstrap still works for the Android toolchain).
# hg      : Mercurial mozilla-unified (classic ./mach workflow, largest).
SOURCE_METHOD="git"

# Where the checked-out source tree lives. Kept OUT of this git repo (.gitignore)
# — it is tens of GB. Override by exporting GECKO_SRC before running.
GECKO_SRC="${GECKO_SRC:-$PWD/gecko}"

# --- Build targets -------------------------------------------------------------
# Android ABIs to build, space-separated Rust target triples. We ship two:
#   aarch64-linux-android  -> arm64-v8a (phones/tablets)
#   x86_64-linux-android   -> x86_64    (emulators / Chromebooks)
# Each is built into its own objdir, then 04-build.sh fat-AARs them into one
# multi-ABI artifact published to mavenLocal. Other valid triples:
#   arm-linux-androideabi  -> armeabi-v7a
#   i686-linux-android     -> x86
ANDROID_TARGETS="aarch64-linux-android x86_64-linux-android"

# --- Compilation parallelism ---------------------------------------------------
# Number of parallel jobs for `mach build` (passed as -jN; also sets
# CARGO_BUILD_JOBS for the Rust side). Leave EMPTY to let mach auto-detect (all
# logical cores). Pin it to bound RAM: Gecko's Rust/LTO link + codegen steps are
# memory-hungry, so on a high-core machine a full -j$(nproc) can OOM. 16 is a
# deliberate cap for a 32-core box (leaves headroom for the link phase).
BUILD_JOBS="16"

# --- Existing Android SDK / NDK (skip the bootstrap download) -------------------
# Step 02 (`mach bootstrap`) otherwise downloads the Android SDK + NDK (several
# GB) into ~/.mozbuild. If you ALREADY have them, point these at the folders:
#   - 02-bootstrap.sh skips entirely when BOTH are set (relies on step 00 having
#     installed the JDK 17 + rustup host deps on Arch);
#   - 04-build.sh injects them as `--with-android-sdk` / `--with-android-ndk`
#     into the mozconfig and exports ANDROID_HOME for the gradle step.
#
# IMPORTANT: Firefox pins an EXACT NDK version per release. Your NDK must be the
# version FIREFOX_VERSION expects or configure fails loudly (it won't silently
# misbuild) — check the source's `python/mozboot/mozboot/android.py`
# (NDK_VERSION) for the pin. The SDK is more forgiving (needs the required
# platform + build-tools). Leave BOTH empty to let bootstrap manage everything.
# Point at the SDK root (the dir containing platform-tools/, platforms/, …) and
# the NDK root (e.g. <sdk>/ndk/<version> or a standalone NDK dir). NOTE: FF 151
# pins NDK **r29** — your NDK folder must be r29 or configure fails loudly.
#
# These honour the matching environment variables if you've exported them, so
# you can either hardcode a path here or `export ANDROID_HOME=… ANDROID_NDK_HOME=…`
# before running build.sh. (Use ANDROID_HOME/ANDROID_SDK_ROOT for the SDK —
# ANDROID_SDK_HOME is a DIFFERENT thing, the .android config dir, and is ignored.)
ANDROID_SDK_ROOT="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT:-${ANDROID_NDK_HOME:-${ANDROID_NDK:-}}}"

# WASI sysroot — only relevant on the skip-bootstrap path above. Firefox compiles
# a few memory-unsafe parser libs (expat/woff2/graphite/hunspell/ogg) to
# wasm32-wasi and RLBox-sandboxes them, which needs WASI headers/libs. A
# bootstrap build fetches them; reusing your own NDK does not.
#   - SET this -> KEEP RLBox (more hardened, the stock-Firefox config; costs a
#     little speed for those parsers). On Arch: `pacman -S wasi-libc
#     wasi-compiler-rt` and point here at the sysroot (usually
#     /usr/share/wasi-sysroot — verify with `pacman -Ql wasi-libc | grep include`).
#   - LEAVE EMPTY -> 04-build.sh falls back to --without-wasm-sandboxed-libraries:
#     those libs run NATIVE (slightly faster) but un-sandboxed (less secure).
# Honours an exported WASI_SYSROOT.
WASI_SYSROOT="${WASI_SYSROOT:-}"

# --- App integration -----------------------------------------------------------
# Path to your local firedown app checkout, used by 05-sync-to-app.sh to print
# (and optionally apply) the build.gradle wiring. Override via env if elsewhere.
FIREDOWN_APP="${FIREDOWN_APP:-$HOME/firedown}"
