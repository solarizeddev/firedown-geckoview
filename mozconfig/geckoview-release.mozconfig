# Firedown GeckoView — release build for Android (GeckoView AAR, no browser app).
#
# scripts/04-build.sh copies this to <gecko-src>/mozconfig once per ABI (phase 1,
# the real compile), appending `--target=<triple>` + `MOZ_OBJDIR`. This file stays
# static. The phase-2 fat-AAR repackage does NOT use this template — it's a
# `--disable-compile-environment` pass, and configure REJECTS the compile-only
# options below in that mode (--disable-rust-tests, --enable-strip, …), so
# 04-build.sh writes a separate MINIMAL mozconfig for it (application + release +
# geckoview-lite + the fat-AAR inputs). Keep compile-only flags here, out of that
# minimal set.

# --- What we're building -------------------------------------------------------
ac_add_options --enable-application=mobile/android
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --disable-rust-tests

# GeckoView "Lite" build. Two reasons:
#   1. artifactId is `geckoview` (NOT `geckoview-omni`) — Gecko's computeArtifactId
#      appends `-omni` UNLESS this is set. The firedown app depends on
#      `org.mozilla.geckoview:geckoview`, and this matches the coordinate we used
#      to pull from Mozilla's Maven, so 05-sync wires the same artifactId.
#   2. The option's own help: "Removes unnecessary dependencies like Glean" — so
#      lite mode drops the Glean telemetry dep, shrinking the AAR (belt-and-
#      suspenders with patch 0004's FOG endpoint neuter + the telemetry prefs).
ac_add_options --enable-geckoview-lite

# --- Shrink the shipped binaries (strip symbols) -------------------------------
# libxul.so is by far the dominant APK weight; UNSTRIPPED it can be ~1 GB, and
# stripped only ~100-200 MB. A local --enable-release build does NOT strip by
# default, so strip both the build output and the packaged/installed libs — the
# AAR (and the app APK that bundles it, per ABI) then carry no debug symbols.
# Safe here: crashreporter is disabled and this is a no-telemetry app, so we
# never need the symbols for symbolication.
ac_add_options --enable-strip
ac_add_options --enable-install-strip

# --- Strip the reporting / data-collection machinery at build level ------------
# Crash reporting + parental controls are removed via real configure OPTIONS.
ac_add_options --disable-crashreporter
ac_add_options --disable-parental-controls
# The telemetry / data-reporting / healthreport / normandy MOZ_* vars are NOT
# settable from a mozconfig in FF 151 — configure DERIVES them and ERRORS if you
# try ("MOZ_SERVICES_HEALTHREPORT= can not be set by mozconfig ... accepted from:
# implied"), so they're intentionally omitted (not just commented — present-but-
# wrong fails the whole configure). They're covered without the flags: this is a
# non-MOZILLA_OFFICIAL build (telemetry reporting is compiled off by default),
# --disable-crashreporter above drops the crash/data-report plumbing, and the
# runtime prefs in firedown/prefs/firedown-geckoview.js disable telemetry, data
# reporting, healthreport and Normandy. The prefs are the load-bearing layer,
# same as DRM. (MOZ_CRASHREPORTER is likewise implied by --disable-crashreporter.)

# --- DRM / EME off -------------------------------------------------------------
# NOTE: FF 151's mobile/android configure REJECTS `--disable-eme`
# ("InvalidOptionError: --disable-eme is not available in this configuration"),
# so it is intentionally NOT set here. DRM/EME is still fully disabled at runtime
# by the default pref media.eme.enabled=false (firedown/prefs/firedown-geckoview.js)
# plus the app's setDRM, so nothing functional is lost — DRM-off never depended on
# this build flag alone. If a future Firefox version accepts the flag again and you
# want belt-and-suspenders EME removal at compile time, re-add:
#   ac_add_options --disable-eme

# --- Android toolchain ---------------------------------------------------------
# After `./mach bootstrap` (scripts/02-bootstrap.sh) the SDK/NDK live under
# ~/.mozbuild and mach auto-detects them; no explicit --with-android-sdk needed.
# To reuse an EXISTING SDK/NDK instead of bootstrapping, don't edit this file —
# set ANDROID_SDK_ROOT / ANDROID_NDK_ROOT in config/build.env; 04-build.sh then
# appends the matching --with-android-sdk / --with-android-ndk per ABI and skips
# the step-02 download.

# Speed: use sccache if present (bootstrap can install it). Harmless if absent
# is NOT true — only enable if you actually have it. Left commented by default.
# ac_add_options --with-ccache=sccache
